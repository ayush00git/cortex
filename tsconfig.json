{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["main.ts", "mcp/**/*", "rag/**/*", "ingest/**/*"],
  "exclude": ["node_modules", "dist", "storage"]
}
